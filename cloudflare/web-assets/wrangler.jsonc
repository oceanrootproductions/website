// Serves the website's big demo files (Ocean Engine asset packs) from the R2 bucket "oceanroot-web", so they stay out of git
// and visitors download them from Cloudflare (R2 downloads are free) instead of Netlify. Public and read-only.
// The site points at it with a redirect in public/_redirects. Upload a pack: sh upload-pack.sh; deploy: npm run deploy.
// The bucket is separate from the engine's private "ocean-lfs" bucket, so nothing here can expose game originals.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oceanroot-web-assets",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "e1e3002cdfc8fee23abe25356538b41d",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "oceanroot-web" }],
  // A per-visitor safety net against scripted hammering. Generous on purpose: a lecture hall shares one IP address.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4201", "simple": { "limit": 300, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "https://oceanrootproductions.com,https://www.oceanrootproductions.com,http://localhost:5173"
  }
}
